{
    "name": "kanso-ya/cms",
    "description": "CMS ultra-léger et évolutif pour les clubs et associations sportives",
    "type": "project",
    "require": {
        "php": ">=8.5.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "Core\\": "core/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform-check": true
    }
}