# ==============================================================================
# KANSO-YA V2 — FRONT-CONTROLLER UNIQUE & VERROUILLAGE /public/ (Lot R2)
# ==============================================================================
Options -Indexes -MultiViews
DirectoryIndex index.php

# En-têtes de sécurité HTTP
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Blocage des fichiers cachés (.htaccess, .env, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Conserver l'en-tête Authorization pour l'API REST et Playwright
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

    # 2. Blocage strict de tout accès direct à un fichier .php hors index.php et api.php (Sprint 19 — Lot R5)
    RewriteCond %{THE_REQUEST} \s/+[^\s?]*\.php[\s?] [NC]
    RewriteCond %{REQUEST_URI} !^/(index|api)\.php$ [NC]
    RewriteRule \.php$ - [F,L,NC]

    # 3. Interdiction de toute tentative d'accès à des segments internes via /public/
    RewriteRule ^(Core|core|modules|storage|docs|tests|vendor)(/|$) - [F,L,NC]

    # 4. Ne pas réécrire les deux front-controllers autorisés
    RewriteRule ^(index|api)\.php$ - [L,NC]

    # 5. Trafic API -> Front-Controller API unique
    RewriteCond %{REQUEST_URI} ^/api(/|$) [NC]
    RewriteRule ^(.*)$ api.php [L,QSA]

    # 6. Assets statiques existants (assets/, uploads/, etc.) servis directement (hors .php)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_URI} !\.php$ [NC]
    RewriteRule ^ - [L]

    # 7. Tout le reste -> Front-Controller UI unique (PageRouter)
    RewriteRule ^ index.php [L,QSA]
</IfModule>
