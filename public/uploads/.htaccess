# ==============================================================================
# KANSO-YA V2 — VERROUILLAGE /public/uploads/ (Défense en profondeur no-exec)
# ==============================================================================
Options -Indexes -ExecCGI

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phar|pl|py|cgi|sh|exe|bat|cmd)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
