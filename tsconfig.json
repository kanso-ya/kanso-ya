{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "rootDir": "./Core/Ui/ts",
        "outDir": "./public/assets/ts",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["Core/Ui/ts/**/*"],
    "exclude": [
        "node_modules",
        "tests",
        "playwright.config.ts"
    ]
}