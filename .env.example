# Environnement et hooks QA
APP_ENV=production
QA_HOOKS_ENABLED=0

# Configuration de la base de données
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=storage/db/kanso-ya.sqlite
DB_USERNAME=root
DB_PASSWORD=

# URL furtive du Superadmin
SUPERADMIN_URL=/sys-admin-xyz

# Clé de chiffrement applicative (secrets SMTP) & surcharge optionnelle mot de passe SMTP
# APP_KEY=changez-moi-avec-une-cle-aleatoire-32-caracteres
# SMTP_PASSWORD=
