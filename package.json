{
    "name": "kanso-ya",
    "version": "1.0.0",
    "description": "Outillage Frontend (TS/Tailwind) et Tests E2E (Playwright) du CMS",
    "type": "module",
    "scripts": {
        "build:ts": "tsc",
        "watch:ts": "tsc -w",
        "build:css": "tailwindcss -i ./src/input.css -o ./public/assets/css/tailwind.css --minify",
        "db:reset": "php Core/Api/Database/Migrations/002_core_seed.php",
        "db:check-mysql": "php Core/Api/Database/check_mysql_compat.php",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "report:allure": "allure generate allure-results --clean -o allure-report && allure open",
        "test:allure": "npx playwright test & npx allure serve allure-results --port 8085"
    },
    "devDependencies": {
        "@playwright/test": "^1.42.0",
        "@types/node": "^20.19.43",
        "allure-playwright": "^2.15.0",
        "tailwindcss": "^3.4.1",
        "typescript": "^6.0.3"
    }
}
